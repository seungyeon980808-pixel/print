// 파트 3 · 별의 표면 온도와 색 — 개념편(따로 배부). 교과서 288–289쪽
#import "../concept.typ": *
#import "../개념편/figs.typ": fig-color, cv, dot, ln, lb, star-colors

#let info = (
  school: "대왕중학교", course: "2학년 과학B 기말고사 대비",
  series: "별과 우주 기출 탐구", no: 3, title: "별의 표면 온도와 색",
  goals: ("표면 온도와 별의 색", "색으로 표면 온도 비교하기", "색과 밝기는 다른 성질"),
)

// 오리온자리(교과서 288쪽 그림 7 바탕)
#let fig-orion = cv(40mm, 44mm, {
  let s = ((9mm, 6mm), (31mm, 9mm), (16.5mm, 21mm), (20mm, 22mm), (23.5mm, 23mm), (12mm, 38mm), (32mm, 36mm))
  for (i, j) in ((0, 2), (1, 4), (2, 3), (3, 4), (2, 5), (4, 6), (0, 1)) { ln(s.at(i), s.at(j), st: 0.4pt + luma(150)) }
  for (k, p) in s.enumerate() { dot(p.at(0), p.at(1), r: if k in (0, 6) { 2mm } else { 1mm }, fill: if k == 0 { star-colors.at(6) } else if k == 6 { star-colors.at(1) } else { luma(140) }, stroke: if k in (0, 6) { 0.4pt + luma(150) } else { none }) }
  lb(9mm, 9mm, [베텔게우스(적색)], a: "c", s: 5.8pt, b: true)
  lb(30mm, 39.4mm, [리겔(청백색)], a: "c", s: 5.8pt, b: true)
})

#show: body => concept-doc(info, body)

#concept-box[별의 색은 표면 온도로 정해진다][
  - 용암은 흘러가며 식으면서 노란색 → 빨간색 → 검은색으로 변한다. 이처럼 물체의 색은 #key[온도]에 따라 달라진다.
  - 별도 #key[표면 온도]에 따라 색이 다르다. 표면 온도가 #key[높을수록 파란색], #key[낮을수록 붉은색]을 띤다.
  - 따라서 별의 색을 관측하면 #key[표면 온도를 비교]할 수 있다.
  #fig(fig-color, [교과서 289쪽 그림 8 · 별의 색과 표면 온도])
]

#concept-box[색에 따른 별의 예 #text(size: 7.4pt, weight: "regular", fill: gray)[(교과서 289쪽 그림 8)]][
  #ctab((0.8fr, 2fr), th[색], th[별의 예],
    [청색], [나오스],
    [청백색], [리겔, 스피카],
    [백색], [시리우스, 베가],
    [황백색], [카노푸스, 프로키온],
    [황색], [태양(약 6000 K), 카펠라],
    [주황색], [아르크투루스, 알데바란],
    [적색], [베텔게우스, 안타레스], note: [위쪽일수록 표면 온도가 높다])
]

#concept-box[오리온자리로 보는 색 차이][
  #grid(columns: (40mm, 1fr), column-gutter: 3mm, align: horizon,
    fig-orion,
    [#set par(justify: false)
     - 같은 별자리 안에서도 별의 색이 다르다.
     - 적색인 #key[베텔게우스]는 표면 온도가 낮고, 청백색인 #key[리겔]은 표면 온도가 높다.])
]

#concept-box[분석 · 알비레오 A와 B #text(size: 7.4pt, weight: "regular", fill: gray)[(교과서 289쪽)]][
  - 백조자리의 알비레오는 주황색 별(A)과 청색 별(B)이 함께 보이는 쌍둥이 별이다.
  - 청색인 B가 주황색인 A보다 표면 온도가 높다.
  - 태양(황색)과 비교하면 B는 태양보다 뜨겁고, A는 태양보다 차갑다.
]

#concept-box[생활 속 온도와 색][
  #ctab((1fr, 2fr), al: (center + horizon, left + horizon),
    th[용암], [갓 나온 뜨거운 용암은 노란색, 식으면 빨간색 → 검은색 #text(size: 7pt, fill: luma(110))[(교과서 288쪽)]],
    th[쇳물], [아주 뜨거운 쇳물은 흰빛에 가깝고, 식으면 붉어진다],
    th[가스 불꽃], [파란 불꽃이 붉은 촛불보다 온도가 높다])
  - 별도 같다. 하얗거나 파랗게 보이는 별일수록 뜨겁고, 붉게 보이는 별일수록 차갑다.
]

#concept-box[연습 · 색으로 표면 온도 순서 정하기][
  #ctab((1fr,) * 6, th[프로키온], th[안타레스], th[스피카], th[카펠라], th[나오스], th[알데바란],
    [황백색], [적색], [청백색], [황색], [청색], [주황색])
  - 표면 온도가 높은 것부터: #box(width: 100%, stroke: (bottom: hair), height: 1em)
  - 태양과 표면 온도가 가장 비슷한 별: #box(width: 22mm, stroke: (bottom: hair), height: 1em)
]

#concept-box[별의 자료를 읽는 법][
  #ctab((1fr, 1.7fr), al: (center + horizon, left + horizon),
    th[색], [→ #key[표면 온도] (파랄수록 뜨겁다)],
    th[겉보기 등급], [→ 지구에서 #key[보이는 밝기]],
    th[절대 등급], [→ #key[실제 밝기]],
    th[겉보기 − 절대], [→ #key[거리] (클수록 멀다)])
  - 색과 밝기는 서로 다른 성질이다. 파란 별이라고 항상 밝게 보이거나 실제로 밝은 것은 아니다.
]

#concept-box[한눈에 정리][
  #ctab((1fr, 2fr), al: (center + horizon, left + horizon),
    th[색과 온도], [표면 온도가 높을수록 파랗고, 낮을수록 붉다],
    th[색의 순서], [청 > 청백 > 백 > 황백 > 황 > 주황 > 적],
    th[태양], [황색 별, 표면 온도 약 6000 K],
    th[예], [리겔(청백, 뜨거움) · 베텔게우스(적, 차가움)])
]

#quiz(
  ox: (
    [별의 색은 표면 온도에 따라 달라진다.],
    [표면 온도가 높은 별일수록 붉은색을 띤다.],
    [태양은 황색 별이다.],
    [베텔게우스는 리겔보다 표면 온도가 높다.],
    [청색 별은 적색 별보다 표면 온도가 높다.],
    [시리우스는 백색 별이다.],
    [파란 별은 항상 붉은 별보다 밝게 보인다.],
    [별의 색을 관측하면 표면 온도를 비교할 수 있다.],
  ),
  fill: (
    [별의 색을 결정하는 것은 별의 #b 이다.],
    [태양의 표면 온도는 약 #b K이다.],
    [오리온자리에서 청백색으로 보이는 별은 #b 이다.],
    [청백색과 황색 사이에 오는 색은 백색과 #b 이다.],
    [안타레스는 #b 색 별이다.],
    [별의 실제 밝기는 색이 아니라 #b 등급으로 비교한다.],
  ),
  calc: (
    [청색, 황색, 적색 별을 표면 온도가 높은 것부터 쓰시오.],
    [표면 온도가 4000 K인 별은 태양보다 뜨거운가, 차가운가?],
    [카펠라와 표면 온도가 비슷한 별은? (태양, 리겔 중)],
    [베가와 베텔게우스 중 표면 온도가 높은 별은?],
    [주황색 별과 백색 별 중 태양보다 뜨거운 별은?],
    [태양이 지금보다 식으면 어떤 색 쪽으로 변하겠는가?],
  ),
)

#essay(
  [밤하늘의 별들은 서로 다른 색으로 보인다. 별의 색이 다른 까닭을 설명하고, 이를 이용하여 알 수 있는 것을 쓰시오.],
  conds: ([표면 온도를 포함할 것], [두 문장 이내로 쓸 것]),
)

#answers(
  ("O", "X", "O", "X", "O", "O", "X", "O", "표면 온도", "6000", "리겔", "황백색", "적", "절대", "청색, 황색, 적색", "차갑다", "태양", "베가", "백색 별", "붉은색(적색) 쪽"),
  essay-answer: [별마다 표면 온도가 다르기 때문이다. 별의 색을 관측하면 별의 표면 온도를 비교할 수 있다.],
  essay-points: ("표면 온도가 다르다", "색으로 표면 온도를 비교할 수 있다"),
  extra: [#text(font: sans, weight: "bold", size: 8pt)[연습 답] 나오스, 스피카, 프로키온, 카펠라, 알데바란, 안타레스 · 태양과 비슷한 별: 카펠라],
)
