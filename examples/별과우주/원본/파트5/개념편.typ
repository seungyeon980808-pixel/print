#import "../개념편/figs.typ": fig-balloon, fig-bigbang

#let info = (
  school: "대왕중학교", course: "2학년 과학B 기말고사 대비",
  series: "별과 우주 기출 탐구", no: 5, title: "팽창하는 우주",
  goals: ("외부 은하", "풍선 모형으로 보는 우주 팽창", "우주의 탄생"),
)

#show: body => concept-doc(info, body)

#concept-box[외부 은하][
  - 우주에는 태양계가 속한 우리은하를 포함해 무수히 많은 은하가 있다.
  - 우리은하 밖에 있는 은하를 #key[외부 은하]라고 한다.
  - #key[허블]은 외부 은하를 관측하여 은하들 사이의 거리가 #key[점점 멀어진다]는 것을 알아냈다.
]

#concept-box[탐구 · 풍선 모형으로 우주 팽창 알아보기 #text(size: 7.4pt, weight: "regular", fill: gray)[(교과서 298쪽)]][
  + 풍선을 작게 불어 붙임딱지를 골고루 붙이고 세 개에 1, 2, 3을 쓴다.
  + 1\~2, 1\~3 사이의 거리를 잰다.
  + 풍선을 더 크게 불고 다시 잰다.
  #fig(fig-balloon, [풍선 표면 = 우주 공간, 붙임딱지 = 은하])
  #v(1mm)
  #ctab((1.2fr, 1fr, 1fr), th[구분], th[1\~2 사이], th[1\~3 사이],
    [불기 전], [3 cm], [6 cm],
    [크게 분 뒤], [6 cm], [12 cm], note: [측정값은 예시])
  - 결과: 붙임딱지 사이의 거리가 #key[모두] 멀어진다. 처음에 멀리 있던 붙임딱지일수록 더 많이 멀어진다.
]

#concept-box[우주는 팽창한다][
  - 풍선 표면이 팽창할수록 붙임딱지 사이가 멀어지듯, 외부 은하들 사이의 거리가 멀어지는 것은 #key[우주 공간이 팽창]하기 때문이다.
  - 팽창하는 풍선 표면에 중심이 없는 것처럼, 팽창하는 우주에도 #key[중심이 없다].
  - 어느 은하에서 보아도 다른 은하들은 멀어진다.
  - 비유: 건포도빵 반죽이 부풀면 건포도(은하) 사이가 모두 멀어진다. #text(size: 7.4pt, fill: luma(110))[(교과서 299쪽)]
]

#concept-box[우주의 탄생][
  #fig(fig-bigbang, [교과서 299쪽 그림 12 · 팽창하는 우주 모형])
  #v(1mm)
  - 팽창하는 우주의 시간을 #key[과거로 되돌리면] 우주의 크기는 점점 작아진다.
  - 이를 바탕으로 과학자들은 우주가 약 #key[138억 년 전]에 탄생하였고, 점점 팽창하여 지금의 모습이 되었다고 설명한다.
  - 우주가 팽창해도 물질의 양(질량)은 그대로이고, 부피는 커지며, 밀도는 작아진다.
]

#concept-box[한눈에 정리][
  #ctab((1fr, 2fr), al: (center + horizon, left + horizon),
    th[외부 은하], [우리은하 밖의 은하],
    th[허블], [외부 은하들이 서로 멀어짐을 알아냄],
    th[풍선 모형], [풍선 표면 = 우주, 붙임딱지 = 은하],
    th[우주 팽창], [은하 사이가 멀어진다, 중심이 없다],
    th[탄생], [약 138억 년 전, 지금도 팽창 중])
]

