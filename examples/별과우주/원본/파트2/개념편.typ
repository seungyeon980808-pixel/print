// 파트 2 · 별의 등급과 밝기 — 개념편(따로 배부). 교과서 284–287쪽
#import "../concept.typ": *
#import "../개념편/figs.typ": fig-light, fig-mag, fig-abs

#let info = (
  school: "대왕중학교", course: "2학년 과학B 기말고사 대비",
  series: "별과 우주 기출 탐구", no: 2, title: "별의 등급과 밝기",
  goals: ("밝기와 거리의 관계", "겉보기 등급과 절대 등급", "등급으로 거리 비교하기"),
)

#show: body => concept-doc(info, body)

#concept-box[별의 밝기와 거리][
  - 밤하늘의 별은 밝기가 다양하다. 별의 #key[실제 밝기]가 다르거나, 지구로부터의 #key[거리]가 다르기 때문이다.
  #fig(fig-light, [같은 양의 빛이 거리의 제곱만큼 넓은 곳으로 퍼진다.])
  #v(1mm)
  - 별의 밝기는 #key[거리의 제곱에 반비례]한다. 거리가 2배 → 1/4배, 3배 → 1/9배.
]

#concept-box[탐구 · 거리에 따른 빛의 세기 #text(size: 7.4pt, weight: "regular", fill: gray)[(교과서 284–285쪽)]][
  + 전구를 스마트 기기에서 0.5 m 떨어진 곳에 두고 빛의 세기 측정 앱으로 잰다.
  + 거리를 1 m, 1.5 m, 2 m로 바꾸며 다시 잰다.
  #ctab((1.3fr, 1fr, 1fr, 1fr, 1fr), th[거리(m)], [0.5], [1.0], [1.5], [2.0], th[빛의 세기(예)], [400 lx], [100 lx], [약 44 lx], [25 lx], note: [거리가 2배가 되면 빛의 세기는 1/4배])
  - 결과: 빛의 세기 × 거리#sup[2] 값이 거의 일정하다. 즉, 빛의 세기는 거리의 제곱에 반비례한다.
]

#concept-box[별의 등급][
  - #key[히파르코스]는 맨눈으로 가장 밝게 보이는 별을 1등급, 가장 어둡게 보이는 별을 6등급으로 정했다.
  - #key[등급이 작을수록 밝은 별]이다. 1등급보다 밝으면 0등급, −1등급처럼 나타낸다.
  #fig(fig-mag, [1등급 차이는 약 2.5배, 5등급 차이는 100배])
  #ctab((1.3fr,) + (1fr,) * 6, th[등급 차], [1], [2], [3], [4], [5], [10], th[밝기 비], [2.5배], [6.3배], [16배], [40배], [100배], [1만 배], note: [밝기 비는 약값])
]

#concept-box[겉보기 등급과 절대 등급][
  - #key[겉보기 등급]: 우리 눈에 보이는 밝기로 정한 등급. 가장 밝게 보이는 별은 태양(−26.7등급)이다.
  - 태양이 가장 밝게 보이는 것은 #key[가장 가까이 있기 때문]이다. 실제 밝기는 같은 거리에서 비교해야 한다.
  - #key[절대 등급]: 모든 별이 #key[10 pc]에 있다고 할 때의 등급. 별의 #key[실제 밝기]를 비교한다. 태양의 절대 등급은 +4.8이다.
  #fig(fig-abs, [10 pc로 옮겼을 때 밝아지는지 어두워지는지 생각한다.])
  #ctab((1.2fr, 1fr), th[별까지의 거리], th[등급 비교],
    [10 pc보다 가깝다], [겉보기 \< 절대 (예: 시리우스 −1.5 \< +1.4)],
    [10 pc], [겉보기 = 절대],
    [10 pc보다 멀다], [겉보기 \> 절대 (예: 베텔게우스 0.6 \> −5.9)], note: [교과서 287쪽])
]

#concept-box[등급으로 거리 비교하기][
  - (겉보기 등급 − 절대 등급) 값이 #key[클수록 멀리] 있는 별이다.
  #ctab((1.5fr,) + (1fr,) * 4, th[겉보기 − 절대], [−5], [0], [+5], [+10], th[거리], [1 pc], [10 pc], [100 pc], [1000 pc])
  - 거리가 10배가 되면 밝기는 1/100배 → 5등급 어두워진다.
  - 예: 100 pc에 있는 별의 겉보기 등급이 6이면, 절대 등급은 6 − 5 = 1등급이다.
]

#concept-box[분석 · 세 별의 거리 비교하기 #text(size: 7.4pt, weight: "regular", fill: gray)[(교과서 287쪽)]][
  #ctab((1.3fr, 1fr, 1fr, 1.2fr), th[별], th[겉보기 등급], th[절대 등급], th[겉보기 − 절대],
    [알타이르], [0.77], [2.2], [−1.43],
    [아르크투루스], [−0.04], [−0.3], [0.26],
    [리겔], [0.12], [−6.8], [6.92])
  - 가장 밝게 보이는 별: 겉보기 등급이 가장 작은 #key[아르크투루스]
  - 실제로 가장 밝은 별: 절대 등급이 가장 작은 #key[리겔]
  - 가까운 순서: (겉보기 − 절대)가 작은 순 → 알타이르, 아르크투루스, 리겔
]

#concept-box[한눈에 정리][
  #ctab((1fr, 2fr), al: (center + horizon, left + horizon),
    th[밝기와 거리], [밝기는 거리의 제곱에 반비례],
    th[등급], [작을수록 밝다, 5등급 차 = 100배],
    th[겉보기 등급], [보이는 밝기(가까우면 밝게 보인다)],
    th[절대 등급], [10 pc에 둔 밝기 = 실제 밝기],
    th[거리 비교], [겉보기 − 절대가 클수록 멀다])
]

